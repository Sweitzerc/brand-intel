# Copy to .env and fill in. The Raspberry Pi services read this file.
# Never commit your real .env - it holds passwords.

# Login for the dashboard (username: admin). Leave blank for no login.
BRAND_INTEL_PASSWORD=

# Set to 1 to skip the AI models and use fast keyword scoring.
BRAND_INTEL_LITE=0

# Where the dashboard listens. 0.0.0.0 = reachable from other devices on your network.
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860

# Email alerts. For Gmail, create an App Password at
# https://myaccount.google.com/apppasswords (needs 2-Step Verification on)
# and paste it below - not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_TO=
